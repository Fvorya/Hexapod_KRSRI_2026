# Keluaran build simulasi PC (dibuat ulang oleh test-pc/build.sh)
test-pc/bin/

# Ruang kerja subagent-driven-development (scratch, bukan riwayat)
.superpowers/

# legacy-2026 punya repositori sendiri dengan riwayatnya sendiri.
# Sengaja TIDAK diserap ke sini supaya tidak jadi gitlink kosong.
legacy-2026/

# Sampah OS & editor
Thumbs.db
desktop.ini
*.swp

# Bukan bagian firmware -- tetap ada di disk, tidak ikut ke GitHub.
# Dihapus dari riwayat 5 September 2026 atas permintaan; cadangan penuh
# ada di bundle git yang dibuat sebelum penulisan ulang.
docs/
test-pc/

# Cadangan penyuntingan. Ditulis tangan saat mengubah berkas besar dan
# ditinggal di disk dengan sengaja; tidak ada gunanya di riwayat git, yang
# sudah menyimpan versi sebelumnya dengan lebih baik.
*.bak
*.bak[0-9]
*.bak_*

# Bobot model dan arsip. Besar, biner, dan dibuat ulang oleh quantize.py --
# riwayat git bukan tempatnya. best.pt 6 MB, best_op13.onnx 12 MB.
*.pt
*.onnx
*.zip

# Cache Python -- moses/ dijalankan langsung, .pyc tidak pernah dibutuhkan repo.
__pycache__/
*.pyc

# Keadaan perkakas Command Code (settings + taste). Milik mesin ini, bukan repo.
.commandcode/

# Snapshot pohon lama yang tertinggal di disk. Bukan salinan kerja -- dua pohon
# dengan nama berkas sama adalah cara pasti menyunting yang salah.
# TANPA tanda kutip: gitignore memperlakukan " sebagai karakter biasa, jadi
# pola berkutip tidak pernah cocok dan ketiga folder ini tetap muncul di
# 'git status'. Spasi di nama folder tidak perlu di-escape di sini.
/Hexapod_Unlimited_v1.17/
/Hexapod_Unlimited_v1.17 (2)/
/moses v1.19/
/moses/mission_hud_v1.19/

# ====================================================================
# CATATAN 18 Sep 2026 -- aturan '/moses/*.py', '/moses/*.sh', '/moses/*.md',
# '/moses/*.bat', '/moses/*.txt', dan '/moses/arsip/' DIBUANG dari sini.
#
# Aturan itu BENAR untuk tata letak LAMA: yang hidup moses/moses/, sedangkan
# moses/ di tingkat atas cuma snapshot basi yang tertinggal -- dan mengabaikan
# snapshot itu memang tepat.
#
# Sesudah pohon dirapikan, yang HIDUP justru moses/ DI TINGKAT ATAS. Membiarkan
# aturan itu berarti setiap berkas HUD yang ditambahkan sesudah ini diabaikan
# git DIAM-DIAM: berkasnya ada di disk, tidak pernah ikut commit, dan yang
# terlihat cuma "kok perubahan saya tidak muncul di GitHub".
# ====================================================================
