# Keluaran build simulasi PC (dibuat ulang oleh test-pc/build.sh)
test-pc/bin/

# Ruang kerja subagent-driven-development (scratch, bukan riwayat)
.superpowers/

# legacy-2026 punya repositori sendiri dengan riwayatnya sendiri.
# Sengaja TIDAK diserap ke sini supaya tidak jadi gitlink kosong.
legacy-2026/

# Sampah OS & editor
Thumbs.db
desktop.ini
*.swp

# Bukan bagian firmware -- tetap ada di disk, tidak ikut ke GitHub.
# Dihapus dari riwayat 5 September 2026 atas permintaan; cadangan penuh
# ada di bundle git yang dibuat sebelum penulisan ulang.
docs/
test-pc/

# Cadangan penyuntingan. Ditulis tangan saat mengubah berkas besar dan
# ditinggal di disk dengan sengaja; tidak ada gunanya di riwayat git, yang
# sudah menyimpan versi sebelumnya dengan lebih baik.
*.bak
*.bak[0-9]
*.bak_*

# Bobot model dan arsip. Besar, biner, dan dibuat ulang oleh quantize.py --
# riwayat git bukan tempatnya. best.pt 6 MB, best_op13.onnx 12 MB.
*.pt
*.onnx
*.zip

# Salinan basi pohon HUD. Yang HIDUP moses/moses/; yang di tingkat atas
# snapshot lama yang tertinggal, dan dua pohon dengan nama berkas sama adalah
# cara pasti menyunting yang salah. Dibiarkan di disk, tidak ikut ke git.
/moses/*.py
/moses/*.sh
/moses/*.md
/moses/*.bat
/moses/*.txt
/moses/arsip/
/moses/__pycache__/
"Hexapod_Unlimited_v1.17/"
"Hexapod_Unlimited_v1.17 (2)/"
"moses v1.19/"
__pycache__/
